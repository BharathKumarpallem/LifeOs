# ========================================================
# LifeOS — Environment Configuration Template
# All keys below are placeholders. Replace with real credentials in .env.local
# ========================================================

# Application Mode & Hosting
VITE_APP_NAME="LifeOS"
VITE_APP_ENV="development" # development | production
VITE_APP_URL="http://localhost:3000"

# Supabase PostgreSQL Configuration (Optional: runs local-first if omitted)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder"

# Model-Independent AI Provider (Backend-only / Server-side)
# DO NOT expose private OpenAI or Anthropic keys in frontend bundles!
OPENAI_API_KEY="sk-proj-placeholder-for-backend-service"
OPENAI_MODEL="gpt-4o"
ANTHROPIC_API_KEY="sk-ant-placeholder-for-backend-service"

# External Calendar Integration Credentials (OAuth 2.0)
GOOGLE_CLIENT_ID="placeholder-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="placeholder-google-client-secret"
MICROSOFT_GRAPH_CLIENT_ID="placeholder-azure-client-id"
MICROSOFT_GRAPH_TENANT_ID="placeholder-azure-tenant-id"

# Storage & Encryption
ENCRYPTION_SECRET_KEY="replace-with-32-byte-hex-random-salt"
